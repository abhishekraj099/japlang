            {
              "jp": "お名前",
              "reading": "おなまえ",
              "romaji": "onamae",
              "meaning": "(your) name",
              "note": "お makes 名前 polite. Never use it for your own name."
            },
            {
              "jp": "どうぞ",
              "reading": "どうぞ",
              "romaji": "douzo",
              "meaning": "please; go ahead",
              "note": "Offers something or invites someone to go first."
            },
            {
              "jp": "さん",
              "reading": "さん",
              "romaji": "san",
              "meaning": "Mr / Ms",
              "note": "Goes after other people's names, never your own."
